# ExceptionLineage Environment Variables
# Copy this file to .env and fill in the values.

# Backend API
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Agent Model Configuration (Stage 17 / 17.5)
# Options: heuristic (default), llm
AGENT_MODEL=heuristic

# LLM Configuration (when AGENT_MODEL=llm)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_API_KEY=your-api-key-here
AGENT_LLM_BASE_URL=https://api.openai.com/v1

