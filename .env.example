# ExceptionLineage Environment Variables Reference Template
# Copy this file to .env for local development, or set these in Render / Vercel dashboard.

# =============================================================================
# BACKEND API (FastAPI — Render / Cloud / Local)
# =============================================================================
# Cloud providers like Render assign PORT automatically (e.g. 10000).
# API_PORT serves as the local development fallback.
PORT=8000
API_PORT=8000

# CORS Allowed Origins (comma-separated list of browser domains)
# Include your Vercel production domain and local dev origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://exceptionlineage.vercel.app

# CORS Origin Regex (Permits dynamic Vercel preview branch deployments)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# =============================================================================
# NEO4J GRAPH DATABASE (Neo4j Aura / Cloud / Local Docker)
# =============================================================================
# For Neo4j Aura (Cloud):
#   NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# For Local Docker:
#   NEO4J_URI=bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# =============================================================================
# FRONTEND (Next.js — Vercel / Local)
# =============================================================================
# For Local Dev:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
# For Production on Vercel:
#   NEXT_PUBLIC_API_URL=https://exceptionlineage-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# AGENT MODEL CONFIGURATION
# =============================================================================
# Options: heuristic (default offline deterministic planner), llm
AGENT_MODEL=heuristic

# LLM Configuration (when AGENT_MODEL=llm)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_API_KEY=your-api-key-here
AGENT_LLM_BASE_URL=https://api.openai.com/v1
